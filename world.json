{
  "seed": "x6lp28cd6bn",
  "lore": {
    "worldName": "Aerthos (The Eternal Realm)",
    "creationMyth": "The Primordial Weave of Aerthos was spun from the dreams of Aethel, the Silent Architect. From the shimmering threads of starlight and the deep currents of the void, she wove the continents, infused them with life, and breathed magic into the very air. Her first creations were the Elder Dragons, guardians of the elemental forces, who then carved the mountains and seas. When her work was complete, Aethel receded, leaving behind echoes of her power that resonate through the land as the source of all arcane might.",
    "era": "The Age of Unification",
    "cultures": [
      {
        "name": "Wildlands",
        "description": "Nomadic tribes deeply connected to untamed nature, residing in dense forests and rugged mountains. They revere primal spirits and ancient beasts, living in harmony with the wildlands.",
        "values": [
          "Freedom",
          "Resilience",
          "Harmony with Nature"
        ],
        "traditions": [
          "Spirit-Walk (communing with animal spirits)",
          "Rite of the Great Hunt (proving oneself by tracking and respectfully taking down a formidable beast)"
        ]
      },
      {
        "name": "Astellian",
        "description": "An ancient, regal society known for its towering spires, advanced arcane academies, and scholarly pursuits. They are often seen as sophisticated but somewhat aloof, valuing knowledge above all else.",
        "values": [
          "Knowledge",
          "Order",
          "Elegance"
        ],
        "traditions": [
          "The Grand Conclave (annual gathering of mages and scholars)",
          "Star-Gazing Vigil (observing celestial patterns for omens and wisdom)"
        ]
      },
      {
        "name": "Norse",
        "description": "Hardy seafarers and fierce warriors from the cold northern coasts, valuing strength, honor, and saga. They are known for their longships, exploration, and unyielding spirit.",
        "values": [
          "Valor",
          "Loyalty",
          "Endurance"
        ],
        "traditions": [
          "The Mead Hall Feast (celebrating victories and ancestors)",
          "Rune-Casting (seeking guidance from ancient runic symbols)"
        ]
      },
      {
        "name": "Luari",
        "description": "A people of sun-drenched lands, famed for their intricate artistry, vibrant festivals, and deep reverence for their ancestral lineage and the sun, which they believe blesses their lands.",
        "values": [
          "Beauty",
          "Family",
          "Passion"
        ],
        "traditions": [
          "Festival of the Golden Sun (a week-long celebration of light and life)",
          "Ancestral Chant (daily remembrance of forebears)"
        ]
      },
      {
        "name": "Vietic",
        "description": "A culture of diligent farmers and wise river-folk, their society built around communal effort, spiritual tranquility, and intricate water-based architecture, thriving along vast river networks.",
        "values": [
          "Community",
          "Harmony",
          "Perseverance"
        ],
        "traditions": [
          "Water Lantern Festival (honoring river spirits and ancestors)",
          "Harvest Blessing Ceremony (giving thanks for bountiful crops)"
        ]
      },
      {
        "name": "Slovan",
        "description": "Residing in sprawling plains and deep forests, the Slovan are known for their robust craftsmanship, deep connection to the land, and strong sense of kinship and shared history.",
        "values": [
          "Craftsmanship",
          "Hospitality",
          "Tradition"
        ],
        "traditions": [
          "Hearthstone Blessing (consecrating new homes)",
          "Storyteller's Circle (preserving history and folklore through oral tradition)"
        ]
      },
      {
        "name": "Angshire",
        "description": "A people of rolling green hills and fertile farmlands, organized into numerous shires and led by local lords. They value practicality, fairness, and stout defenses against external threats.",
        "values": [
          "Justice",
          "Diligence",
          "Patriotism"
        ],
        "traditions": [
          "Shire Moot (local assemblies for governance and dispute resolution)",
          "Defender's Oath (pledging loyalty to their land and people)"
        ]
      },
      {
        "name": "Yamoto",
        "description": "An island nation defined by strict codes of honor, disciplined martial arts, and profound aesthetic sensibilities, often led by a revered Emperor and his samurai.",
        "values": [
          "Honor",
          "Discipline",
          "Reverence"
        ],
        "traditions": [
          "Tea Ceremony (a meticulous ritual fostering peace and respect)",
          "Bushido Training (lifelong dedication to martial and ethical mastery)"
        ]
      }
