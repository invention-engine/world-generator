    "history": [
      {
        "era": "The Age of Scattered Kingdoms",
        "event": "The First Dragonfall",
        "description": "A cataclysmic event when the Elder Dragons, once guardians of the world, fell into slumber or madness, causing widespread magical disruption and allowing lesser races to rise and form independent kingdoms across Aerthos."
      },
      {
        "era": "The Age of Unification",
        "event": "The Founding of The Unified Empire",
        "description": "Spearheaded by Astellian mages and Angshire strategists, a grand alliance formed to bring order to the fractured lands. Through a mix of diplomacy and conquest, The Unified Empire was established, bringing many cultures under a single banner."
      },
      {
        "era": "The Age of Unification",
        "event": "The Wildland's Rebellion",
